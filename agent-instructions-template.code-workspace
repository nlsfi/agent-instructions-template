{
    "extensions": {
        "recommendations": [
            "editorconfig.editorconfig",
            "davidanson.vscode-markdownlint"
        ]
    },
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        },
        "files.associations": {
            "*.md.jinja": "markdown",
            ".yamllint": "yaml"
        }
    }
}
